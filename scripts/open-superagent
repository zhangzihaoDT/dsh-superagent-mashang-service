#!/usr/bin/env python3
"""Finder launcher. Serialize launches separately from the CLI's operation lock."""
import fcntl
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
ARTIFACTS = ROOT / '.artifacts'


def main():
    ARTIFACTS.mkdir(exist_ok=True)
    with (ARTIFACTS / 'desktop-launch.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        command = [sys.executable, str(ROOT / 'scripts/dsh-superagent')]
        result = subprocess.run([*command, 'status'], capture_output=True, text=True)
        if result.returncode == 1 and 'control operation is in progress' not in result.stderr:
            result = subprocess.run([*command, 'start'], capture_output=True, text=True)
        if result.returncode:
            logs = sorted(ARTIFACTS.glob('dsh-superagent-superagent-*.log'), key=lambda p: p.stat().st_mtime)
            detail = result.stderr.strip() or result.stdout.strip()
            raise RuntimeError(f'{detail}\n\n服务日志：{logs[-1] if logs else ARTIFACTS}')
        subprocess.run(['/usr/bin/open', 'http://127.0.0.1:3082'], check=True)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
